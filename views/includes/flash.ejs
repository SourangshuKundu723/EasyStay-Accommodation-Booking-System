<% if(success && success.length){ %>
    <div class="mt-3 alert alert-success text-success alert-dismissible fade show col-8 offset-2" role="alert">
        <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>
<% if(error && error.length){ %>
    <div class="mt-3 alert alert-danger alert-dismissible fade show col-8 offset-2" role="alert">
        <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<script>
    setTimeout(() => {
        document.querySelectorAll(".alert").forEach(alert => {
            alert.querySelector(".btn-close").click();
        });
    }, 2000);
</script>