<% layout("layouts/boilerplate") %>
<body>
    <div class="category-bar">
        <a href="/listings" class="category <%= !category ? 'active' : '' %>">
            <i class="fa-solid fa-house"></i>
            <span>ALL</span>
        </a>
        <a href="/listings?category=iconic-cities" class="category <%= category === 'iconic-cities' ? 'active' : '' %>">
            <i class="fa-solid fa-city"></i>
            <span>Iconic cities</span>
        </a>
        <a href="/listings?category=mountains" class="category <%= category === 'mountains' ? 'active' : '' %>">
            <i class="fa-solid fa-mountain"></i>
            <span>Mountains</span>
        </a>
        <a href="/listings?category=castles" class="category <%= category === 'castles' ? 'active' : '' %>">
            <i class="fa-brands fa-fort-awesome"></i>
            <span>Castles</span>
        </a>
        <a href="/listings?category=beach" class="category <%= category === 'beach' ? 'active' : '' %>">
            <i class="fa-solid fa-umbrella-beach"></i>
            <span> Beach</span>
        </a>
        <a href="/listings?category=rooms" class="category <%= category === 'rooms' ? 'active' : '' %>">
            <i class="fa-solid fa-bed"></i>
            <span>Rooms</span>
        </a>
        <a href="/listings?category=camping" class="category <%= category === 'camping' ? 'active' : '' %>">
            <i class="fa-solid fa-tent"></i>
            <span>Camping</span>
        </a>
        <a href="/listings?category=farms" class="category <%= category === 'farms' ? 'active' : '' %>">
            <i class="fa-solid fa-cow"></i>
            <span>Farms</span>
        </a>
        <a href="/listings?category=arctic" class="category <%= category === 'arctic' ? 'active' : '' %>">
            <i class="fa-solid fa-snowflake"></i>
            <span>Arctic</span>
        </a>
    </div>
    <div class="row row-cols-1 row-cols-lg-3 row-cols-md-2 mt-3">
        <% for(let listing of allListings){ %>
            <a href="/listings/<%= listing._id %>" class="card-link">
                <div class="card card-display col listing-card">
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing image" style="height: 18rem;">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <h5 class="card-title mt-2"><b><%= listing.title %></b></h5>
                        <p class="card-text">
                            <i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %>
                            <br>
                            <i class="fa-solid fa-indian-rupee-sign"></i> <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %> / night
                        </p>
                    </div>
                </div>
            </a>
        <% } %>
    </div>
</body>