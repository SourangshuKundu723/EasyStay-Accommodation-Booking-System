<% layout("layouts/boilerplate") %>
<body>
    <div class="row">
        <div class="col-8 offset-2">
            <h2 class="heading"><b><%= listing.title %></b></h2>
            <div class="card show-listing-card">
                <img src="<%= listing.image %>" class="card-img-top show-img mb-3" alt="listing image">
                <div class="card-body">
                    <p class="card-text">
                        <i class="fa-solid fa-user"></i> Owned by: <i><span class="fw-semibold"><%= listing.owner.username %></span></i>
                        <br>
                        <i class="fa-solid fa-bars-staggered"></i> <%= listing.description %>
                        <br>
                        <i class="fa-solid fa-indian-rupee-sign"></i> <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %> / night
                        <br>
                        <i class="fa-solid fa-location-dot"></i> <%= listing.location %>
                        <br>
                        <i class="fa-solid fa-earth-americas"></i> <%= listing.country %>
                    </p>
                </div>
                <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
                    <div class="btns mt-3">
                        <form method="get" action="/listings/<%= listing._id %>/edit">
                            <button class="btn btn1 btn-dark"><i class="fa-solid fa-pen-to-square"></i> Edit</button>
                        </form>
                        <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                            <button class="btn btn1 btn-dark"><i class="fa-solid fa-trash-can"></i> Delete</button>
                        </form>
                    </div>
                <% } %>
            </div>
        </div>
        <div class="col-8 offset-2 mb-5">
            <hr>
            <h3 class="mb-3"><b>Leave a review</b></h3>
            <% if(currUser) { %>
                <form method="post" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
                    <div>
                        <label for="rating" class="form-label">Rating</label>
                        <fieldset class="starability-coinFlip">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>
                    <div class="mb-3">
                        <label for="comment" class="form-label">Comment</label>
                        <textarea rows="5" name="review[comment]" id="comment" class="form-control" required></textarea>
                        <div class="invalid-feedback">Please write a comment for this review!</div>
                    </div>
                    <button class="btn btn1 btn-dark"><i class="fa-solid fa-check"></i> Submit</button>
                </form>
            <% } else{ %>
                <div class="mt-5 mb-5" style="text-align: center;">
                    <i class="fa-solid fa-message fs-2 mb-2"></i>
                    <h6><b>Please <a href="/login" class="text-decoration-none">login</a> to create a review</b></h6>
                </div>
            <% } %>
            <hr>
            <h3 class="mb-3"><b>All reviews</b></h3>
            <div class="row">
                <% if(listing.reviews.length > 0){
                    for(let review of listing.reviews){ %>
                        <div class="card review-card col-5 ms-3 mb-3">
                            <div class="card-body mt-3 mb-3">
                                <h5 class="card-title">@<%= review.author.username %></h5>
                                <h6 class="card-subtitle mb-2 text-body-secondary">
                                    <% for(let i=0; i<review.rating ; i++){ %>
                                        <i class="fa-solid fa-star" style="font-size: 0.8rem; color: #FDCC0D;"></i>
                                    <% } %>
                                </h6>
                                <p class="card-text"><%= review.comment %></p>
                            </div>
                            <% if(currUser && currUser._id.equals(review.author._id)) { %>
                                <form class="mb-3" method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                    <button class="btn btn1 btn-sm btn-dark dlt-btn"><i class="fa-solid fa-trash-can"></i> Delete</button>
                                </form>
                            <% } %>
                        </div>
                <% }
                }else{ %>
                    <div class="mt-5 mb-4" style="text-align: center;">
                        <i class="fa-solid fa-message fs-2 mb-2"></i>
                        <h5><b>No review yet!</b></h5>
                        <p>Be the first one to share the review.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</body>